# --- Application ---
APP_NAME="Repetitor CRM API"
ENVIRONMENT=local          # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repetitor
POSTGRES_USER=repetitor
POSTGRES_PASSWORD=repetitor

# Lokal ishlab chiqish uchun Postgres o'rniga SQLite ishlatish mumkin.
# Quyidagi qatorni izohdan chiqarsangiz, Docker/Postgres kerak bo'lmaydi:
# DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./dev.sqlite3

# --- Security ---
# openssl rand -hex 32
SECRET_KEY=change-me-please-generate-a-real-one
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Login urinishlari: 5 urinish / 15 daqiqa
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Yangi o'qituvchi tasdiqlashni kutganda xabar boradigan manzillar.
ADMIN_EMAILS=

# --- Yuklangan fayllar ---
MEDIA_ROOT=media
MEDIA_URL=/media
MAX_AVATAR_BYTES=5242880

# `npm run build` chiqargan web ilova (`web/dist`). Mavjud bo'lsa backend
# uni o'zi serve qiladi (README dagi "Deploy" bo'limiga qarang).
WEB_DIST_DIR=../web/dist

# --- Localisation ---
TIMEZONE=Asia/Tashkent
CURRENCY=UZS

# --- CORS (vergul bilan) ---
# Flutter web dev-server: localhost va 127.0.0.1 — ikki xil origin,
# ikkalasi ham ro'yxatda bo'lishi kerak.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
